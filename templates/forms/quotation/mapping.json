{
  "schema_version": "0.1.0",
  "form_id": "quotation",
  "ko_name": "견적서",
  "source_policy": {
    "canonical_filename": "source.hwpx",
    "path": "templates/forms/quotation/source.hwpx",
    "storage": "private_data_repo",
    "commit_to_public_git": false
  },
  "slots": [
    {"id": "quote_number", "label": "Quote number", "required": true, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{quote_number}}"}},
    {"id": "client_name", "label": "Client name", "required": true, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{client_name}}"}},
    {"id": "quote_date", "label": "Quote date", "required": false, "value_type": "date", "format": "YYYY-MM-DD", "target": {"strategy": "placeholder_token", "token": "{{quote_date}}"}},
    {"id": "item_summary", "label": "Item summary", "required": false, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{item_summary}}"}},
    {"id": "total_amount", "label": "Total amount", "required": true, "value_type": "currency", "target": {"strategy": "placeholder_token", "token": "{{total_amount}}"}},
    {"id": "valid_until", "label": "Valid until", "required": false, "value_type": "date", "format": "YYYY-MM-DD", "target": {"strategy": "placeholder_token", "token": "{{valid_until}}"}}
  ]
}
