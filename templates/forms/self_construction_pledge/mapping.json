{
  "schema_version": "0.1.0",
  "form_id": "self_construction_pledge",
  "ko_name": "자체시공 서약서",
  "source_policy": {
    "canonical_filename": "source.hwpx",
    "path": "templates/forms/self_construction_pledge/source.hwpx",
    "storage": "private_data_repo",
    "commit_to_public_git": false
  },
  "slots": [
    {"id": "project_name", "label": "Project name", "required": true, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{project_name}}"}},
    {"id": "contractor_name", "label": "Contractor name", "required": true, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{contractor_name}}"}},
    {"id": "work_scope", "label": "Work scope", "required": false, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{work_scope}}"}},
    {"id": "construction_period", "label": "Construction period", "required": false, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{construction_period}}"}},
    {"id": "site_address", "label": "Site address", "required": false, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{site_address}}"}},
    {"id": "pledge_date", "label": "Pledge date", "required": true, "value_type": "date", "format": "YYYY-MM-DD", "target": {"strategy": "placeholder_token", "token": "{{pledge_date}}"}}
  ]
}
