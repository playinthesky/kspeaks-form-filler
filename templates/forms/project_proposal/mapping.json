{
  "schema_version": "0.1.0",
  "form_id": "project_proposal",
  "ko_name": "사업제안서",
  "source_policy": {
    "canonical_filename": "source.hwpx",
    "path": "templates/forms/project_proposal/source.hwpx",
    "storage": "private_data_repo",
    "commit_to_public_git": false
  },
  "slots": [
    {"id": "project_name", "label": "Project name", "required": true, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{project_name}}"}},
    {"id": "client_name", "label": "Client name", "required": true, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{client_name}}"}},
    {"id": "proposal_date", "label": "Proposal date", "required": true, "value_type": "date", "format": "YYYY-MM-DD", "target": {"strategy": "placeholder_token", "token": "{{proposal_date}}"}},
    {"id": "project_period", "label": "Project period", "required": false, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{project_period}}"}},
    {"id": "total_budget", "label": "Total budget", "required": false, "value_type": "currency", "target": {"strategy": "placeholder_token", "token": "{{total_budget}}"}},
    {"id": "contact_name", "label": "Contact name", "required": false, "value_type": "text", "target": {"strategy": "placeholder_token", "token": "{{contact_name}}"}}
  ]
}
